# ==============================================================================
# CloudGuard Configuration Template
# Problem Statement: CF-PS-09 Cloud File Validation & Processing Platform
# ==============================================================================

# Server Runtime
PORT=5000
NODE_ENV=development

# ------------------------------------------------------------------------------
# Storage Provider Selection
# Options: 'local' (development emulation mode) or 's3' (AWS S3 / MinIO / R2)
# ------------------------------------------------------------------------------
STORAGE_PROVIDER=local

# Local Storage Directory (Used when STORAGE_PROVIDER=local)
STORAGE_LOCAL_DIR=./storage

# ------------------------------------------------------------------------------
# Production Cloud Storage (AWS S3 / S3-Compatible Object Store)
# Required when STORAGE_PROVIDER=s3
# ------------------------------------------------------------------------------
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Isolated Bucket Names (or S3 Key Prefixes)
S3_BUCKET_INCOMING=cloudguard-incoming
S3_BUCKET_PROCESSED=cloudguard-processed
S3_BUCKET_QUARANTINE=cloudguard-quarantine

# Optional: MinIO or LocalStack custom endpoint
# AWS_S3_ENDPOINT=http://localhost:9000
# AWS_S3_FORCE_PATH_STYLE=true

# ------------------------------------------------------------------------------
# Validation Engine Rules
# ------------------------------------------------------------------------------
MAX_FILE_SIZE_BYTES=10485760
ALLOWED_EXTENSIONS=.csv
REQUIRED_CSV_HEADERS=student_id,name,department
ENFORCE_UNIQUE_HASH=true
STRICT_COLUMN_COUNT=true
ALLOW_BLANK_CELLS=false

# ------------------------------------------------------------------------------
# Persistence Layer
# ------------------------------------------------------------------------------
METADATA_FILE=./data/cloudguard-metadata.json
AUDIT_LOGS_FILE=./data/cloudguard-audit.json
SETTINGS_FILE=./data/cloudguard-settings.json
